{
  "_about": "Design tokens for the Mariamlisa site, measured from the Auren template's system (roles, scale, spacing) on 2026-11-10. Values are Mariamlisa's own: her gold accent (#c8a46e) was already in use on her site. Names stay, values may change. Check every change with contrast.py (or contrast.mjs where Python is missing).",
  "_source": {
    "measured_from": "https://auren-template.modulify.website/ (computed styles at 862px viewport)",
    "their_values_for_reference_only": {"bg": "#0b0b0b", "surface": "#111111", "text": "#ededea", "muted": "#a3a3a3", "accent": "#d6a85c", "font": "DM Sans"}
  },
  "color": {
    "bg": "#0b0b0b",
    "surface": "#131313",
    "surface-raised": "#1a1a1a",
    "_borders": "border and border-strong are decorative (card outlines, rules) and carry no meaning, so they are exempt from 3:1. Anything that marks a control (link underline, focus ring) uses text-muted or accent.",
    "border": "#232323",
    "border-strong": "#303030",
    "text": "#ededea",
    "text-muted": "#a3a3a3",
    "accent": "#c8a46e",
    "on-accent": "#0b0b0b"
  },
  "pairs": [
    ["text", "bg"],
    ["text", "surface"],
    ["text", "surface-raised"],
    ["text-muted", "bg"],
    ["text-muted", "surface"],
    ["text-muted", "surface-raised"],
    ["accent", "bg"],
    ["accent", "surface"],
    ["on-accent", "accent"],
    ["accent", "bg", "ui"],
    ["text-muted", "bg", "ui"]
  ],
  "font": {
    "sans": "\"DM Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
  },
  "type": {
    "xs":      {"size": 12, "line": 16, "weight": 400, "tracking": "0.12em", "case": "upper", "use": "eyebrow, nav, meta"},
    "sm":      {"size": 14, "line": 20, "weight": 400, "use": "meta rows, card labels, footer"},
    "base":    {"size": 16, "line": 26, "weight": 400, "use": "body copy"},
    "lg":      {"size": 20, "line": 28, "weight": 300, "tracking": "-0.02em", "use": "card titles, lead lines"},
    "xl":      {"size": 36, "line": 38, "weight": 300, "tracking": "-0.045em", "use": "section headings"},
    "2xl":     {"size": 56, "line": 56, "weight": 300, "tracking": "-0.045em", "use": "statements, big headings"},
    "display": {"size": "clamp(48px, 15vw, 220px)", "line": 0.85, "weight": 600, "tracking": "-0.04em", "use": "name wordmark (hero, footer)"}
  },
  "space": [0, 4, 8, 12, 16, 24, 32, 48, 64, 96, 128],
  "radius": {"sm": 6, "md": 10, "lg": 14, "pill": 999},
  "shadow": {
    "card": "none",
    "pop": "0 30px 60px rgba(0, 0, 0, .5)"
  },
  "motion": {"fast": "200ms", "base": "400ms", "slow": "800ms", "ease": "cubic-bezier(.22, 1, .36, 1)"},
  "layout": {
    "gutter": "clamp(16px, 3.5vw, 40px)",
    "max": "1440px",
    "header": "64px",
    "breakpoints": {"sm": "640px", "md": "768px", "lg": "1024px"}
  }
}
